# Copy to config.env and edit. config.env is gitignored.
# Consumed by both the Makefile (-include) and scripts/ (shell-sourced).
# Keep values plain (KEY=value, no spaces around =).

# Required: SSH-reachable CloudLab node hostname.
CLOUDLAB_HOST=

# Optional: SSH user on the remote. Defaults to your local $USER.
#CLOUDLAB_USER=

# Optional: remote working directory. Defaults to callosal-kv (relative to $HOME).
#CLOUDLAB_REMOTE_DIR=callosal-kv

# Required for remote runs: benchmark data directory on the remote host.
# For single-node local-disk runs, place this on ext4. For multi-node runs,
# point every node at the same shared mount path.
CLOUDLAB_DATA_DIR=/tmp/callosal-kv-data
